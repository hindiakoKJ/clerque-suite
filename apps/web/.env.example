# ── API ────────────────────────────────────────────────────────────────────────
# Base URL of the NestJS API INCLUDING the /api/v1 prefix, no trailing slash.
# The web client does not add the prefix itself: a bare host such as
# http://localhost:3001 makes every request 404 while /health still answers.
# Local dev:  http://localhost:3001/api/v1
# Production: https://api.clerque.cc/api/v1   (set on Vercel, Production scope)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ── Receipt phase ──────────────────────────────────────────────────────────────
# 1 = every receipt prints ACKNOWLEDGEMENT RECEIPT (no BIR CAS/PTU yet).
# The code defaults to 1 when unset; set it explicitly so nobody flips it by
# accident. See DEPLOY.md §3.
NEXT_PUBLIC_PROVIDER_PHASE=1
